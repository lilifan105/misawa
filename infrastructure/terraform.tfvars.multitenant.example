# マルチテナントモード設定例
# このファイルをterraform.tfvarsにコピーして使用してください

# プロジェクト基本設定
project_name = "document-management"
environment  = "dev"
aws_region   = "ap-northeast-1"

# マルチテナントモード設定
multitenant_mode = "true"

# Cognito設定
cognito_region        = "ap-northeast-1"
cognito_user_pool_id  = "ap-northeast-1_xxxxxxxxx"

# マルチテナントRDS設定
multitenant_rds_host     = "multitenant-db.xxxxxxxxx.ap-northeast-1.rds.amazonaws.com"
multitenant_rds_port     = "5432"
multitenant_rds_database = "multitenant"
multitenant_rds_user     = "readonly_user"
multitenant_rds_password = "your-secure-password-here"

# サービス設定
document_service_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# VPC設定（Lambda Authorizer用）
vpc_id             = "vpc-xxxxxxxxx"
private_subnet_ids = ["subnet-xxxxxxxxx", "subnet-yyyyyyyyy"]
rds_cidr_blocks    = ["10.0.0.0/16"]

# CORS設定
cors_origins = [
  "https://documents.example.com",
  "https://portal.example.com"
]

# 外部API設定
external_api_key = "your-api-key-here"
